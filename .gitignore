# =========================
# CORE PYTHON
# =========================
__pycache__/
*.py[cod]
*.pyo
*.pyd

# =========================
# VIRTUAL ENVIRONMENTS
# =========================
venv/
env/
.venv/
ramsey-env/

# =========================
# DJANGO / DATABASE
# =========================
db.sqlite3
db.sqlite3-journal

# =========================
# STATIC / MEDIA OUTPUT
# =========================
staticfiles/
media/
private_media/

# =========================
# ENVIRONMENT SECRETS (CRITICAL)
# =========================
.env
.env.*
!.env.example

# =========================
# CELERY / BACKGROUND TASKS
# =========================
celerybeat-schedule
celerybeat-schedule.db
celerybeat.pid
*.pid

# =========================
# LOGS
# =========================
*.log

# =========================
# PERFORMANCE TEST OUTPUT / TEST CREDENTIALS
# =========================
tests/performance/users.csv
tests/performance/results/

# Local machine-specific launch helpers
serve*.sh

# =========================
# SSL / KEYS (CRITICAL SECURITY)
# =========================
*.pem
*-key.pem
*.key
*.crt
*firebase*.json
*adminsdk*.json
firebase-adminsdk.json
.secrets/
# Allow Android client google-services.json for CI/CD builds
!android/app/google-services.json

# =========================
# IDE / OS FILES
# =========================
.vscode/
.idea/
.DS_Store

# =========================
# BUILD / DISTRIBUTION
# =========================
build/
dist/
*.egg-info/

# =========================
# NODE / FRONTEND (if ever added)
# =========================
node_modules/
dump.rdb
/data.json
# =========================
# ANDROID / GRADLE
# =========================
android/.gradle/
android/local.properties
android/.idea/
android/.kotlin/
android/**/build/
android/**/.cxx/
android/**/captures/

# Android Signing & Keystores
*.jks
*.keystore
*.signing.properties
release.jks
